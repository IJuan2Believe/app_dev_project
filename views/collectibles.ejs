<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/images/store_logo.png">
    <script src="https://kit.fontawesome.com/f7c3808ca6.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css" integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/style.css">
    <title>Goliath</title>
</head>

<body>
<%- include('partials/header') %>

<main class="flex-grow-1">

<h1>Collectibles</h1>
 
<div class="card-container">
  <% items.forEach(item => { %>
    <div class="card">
      <img src="<%= item.image %>" alt="<%= item.name %>" class="img-size" >
      <div class="card-body">
        <h2 class="card-title"><%= item.name %></h2>
        <p class="card-text">$<%= item.price.toFixed(2) %></p>
 

        
        <form action="/cart" method="POST">
          <input type="hidden" name="item_id" value="<%= item.id %>">
          <button type="submit" class="btn purple_btn">Add to cart</button>
        </form>

      </div>
    </div>
  <% }) %>
</div>

</main>

<%- include('partials/footer') %>

 
</body>

</html>